          "type": "pinned_key",
          "subject": "internal-worker-a",
          "public_key": "dqFZIESm5PURJlvKc6YE2QsFKdHfYCvjChmpJXZg0fU",
          "proof": "OTmcGn4c_ZTBTkj4sWdrtTOmqMyOFed3coXLoyWjaQRTDtjPF0vci6khgAaMCArtXKV_CBtv08pByrI3_u7MDg"
        },
        "manifest": {
