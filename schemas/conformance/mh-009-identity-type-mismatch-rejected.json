      "message_type": "mutual_hello",
      "message_id": "770e8400-e29b-41d4-a716-446655440901",
      "timestamp": 1711900000,
      "sender": {
        "agent_id": "aid:pubkey:dqFZIESm5PURJlvKc6YE2QsFKdHfYCvjChmpJXZg0fU"
      },
