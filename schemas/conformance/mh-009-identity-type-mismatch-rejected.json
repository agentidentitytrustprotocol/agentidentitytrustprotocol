          "aid": "aid:pubkey:dqFZIESm5PURJlvKc6YE2QsFKdHfYCvjChmpJXZg0fU",
          "handshake_endpoint": "https://worker-a.agents.example.com/aitp/handshake",
          "accepted_trust_anchors": [
            "https://auth.example.com"
          ],
          "accepted_identity_types": [
            "oidc"
          ],
          "offered_capabilities": [
            "macp.mode.task.v1"
          ],
          "required_peer_capabilities": [],
          "proof_of_possession": {
