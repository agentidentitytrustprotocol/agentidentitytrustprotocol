{
  "id": "tct-004",
  "description": "TCT signature is valid and not expired, but its `jti` appears in the issuing peer's revocation list. Receivers MUST reject with TCT_REVOKED (RFC-AITP-0008). Per the per-issuing-peer model, only the originating issuer's deny list applies.",
  "tags": ["security", "tct", "revocation"],
  "input": {
    "tct_token": {
      "version": "aitp/0.1",
      "jti": "550e8400-e29b-41d4-a716-446655444004",
      "issuer": "aid:pubkey:agentB_pubkey_AID_v01_placeholder_BBBBBBBBB",
      "subject": "aid:pubkey:agentA_pubkey_AID_v01_placeholder_AAAAAAAAA",
      "audience": "aid:pubkey:agentA_pubkey_AID_v01_placeholder_AAAAAAAAA",
      "issued_at": 1711800000,
      "expires_at": 9999999999,
      "grants": ["macp.mode.task.v1"],
      "signature": "__VALID_TCT_SIG__"
    },
    "issuer_revocation_list": {
      "issuer": "aid:pubkey:agentB_pubkey_AID_v01_placeholder_BBBBBBBBB",
      "revoked_jtis": ["550e8400-e29b-41d4-a716-446655444004"],
      "fail_mode": "fail_closed"
    }
  },
  "expected": { "outcome": "failure", "error_code": "TCT_REVOKED" }
}
